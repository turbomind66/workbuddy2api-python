# ============================================================
# workbuddy2api-python 环境变量示例
# 复制为 .env 后按需修改（.env 已被 .gitignore 排除）
# 环境变量优先级高于 config.json
# ============================================================

# 监听地址，格式 host:port
WB2A_LISTEN=:7863

# API 鉴权密钥，客户端调用需携带 Authorization: Bearer <key>
# ⚠️ 务必替换为自己的强密钥，不要使用默认值
WB2A_API_KEY=change-me-to-a-strong-random-key

# 账号凭证目录
WB2A_AUTH_DIR=./auths

# 账号池状态持久化文件
WB2A_STATE_FILE=./data/state.json

# 区域（cn）
WB2A_REGION=cn

# 429 短冷却时长，支持 s/m/h 后缀
WB2A_SOFT_RATE=60s

# 上游请求超时（秒）
WB2A_TIMEOUT_SECONDS=120

# 请求体指纹脱敏（true/false）
WB2A_SANITIZE_FINGERPRINTS=true

# ---------------- Upstash Redis 镜像（可选） ----------------
# 留空则不启用，自动降级为纯内存模式
# WB2A_UPSTASH_URL=https://your-db.upstash.io
# WB2A_UPSTASH_TOKEN=your-token
